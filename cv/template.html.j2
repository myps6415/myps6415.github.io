<!DOCTYPE html>
<!-- GENERATED by scripts/build_cv.py from cv/resume.yaml — do not edit by hand. -->
<html lang="{{ 'zh-Hant' if lang == 'zh' else 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ person.name|t }} — {{ person.headline|t }}</title>
<meta name="description" content="{{ labels.description|t }}">
<link rel="alternate" hreflang="en" href="{{ meta.site }}/cv">
<link rel="alternate" hreflang="zh-Hant" href="{{ meta.site }}/zh/cv">
<link rel="alternate" hreflang="x-default" href="{{ meta.site }}/cv">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F0F1EE; --sheet:#FFFFFF;
    --text:#2A3135; --ink:#14181B; --soft:#5A6268; --line:#D7D9D3;
    --accent:#1C6B57; --accent-ink:#13503F; --accent-tint:#E4ECE7;
    --sans:"IBM Plex Sans TC",system-ui,-apple-system,"Segoe UI","Noto Sans TC",sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
  }
  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{margin:0;background:var(--paper);color:var(--text);font-family:var(--sans);
       font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
  a{color:var(--accent);text-decoration:none;border-bottom:1px solid var(--accent-tint);}
  a:hover{border-bottom-color:var(--accent);}
  .mono{font-family:var(--mono);font-size:.92em;}
  b{color:var(--ink);font-weight:600;}

  /* screen chrome ----------------------------------------------------- */
  .topbar{max-width:820px;margin:0 auto;padding:22px 24px 0;display:flex;justify-content:flex-end;gap:22px;
          font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;}
  .topbar a,.topbar button{color:var(--soft);border:none;background:none;padding:0;cursor:pointer;font:inherit;letter-spacing:inherit;text-transform:inherit;}
  .topbar a:hover,.topbar button:hover{color:var(--accent);}
  .print-btn::before{content:"↓ ";color:var(--accent);}
  .sheet{max-width:820px;margin:16px auto 64px;background:var(--sheet);padding:52px 56px 44px;
         box-shadow:0 1px 2px rgba(0,0,0,.05),0 12px 40px -18px rgba(20,24,27,.25);}
  .foot{max-width:820px;margin:-40px auto 60px;padding:0 24px;font-family:var(--mono);font-size:.7rem;color:var(--soft);letter-spacing:.04em;}

  /* header ------------------------------------------------------------ */
  header{display:grid;grid-template-columns:1fr auto;gap:6px 28px;align-items:start;padding-bottom:16px;border-bottom:2px solid var(--ink);}
  .eyebrow{font-family:var(--mono);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent-ink);font-weight:500;}
  h1{margin:6px 0 0;font-size:2.05rem;line-height:1.1;letter-spacing:-.01em;font-weight:700;color:var(--ink);}
  h1 .alt{display:block;font-family:var(--mono);font-weight:400;font-size:.8rem;letter-spacing:.04em;color:var(--soft);margin-top:6px;}
  .headline{margin:10px 0 0;font-size:1.05rem;font-weight:600;color:var(--ink);}
  .contact{font-family:var(--mono);font-size:.74rem;line-height:1.9;color:var(--soft);text-align:right;padding-top:4px;white-space:nowrap;}
  .contact a{color:var(--soft);border:none;}
  .contact a:hover{color:var(--accent);}
  .summary{grid-column:1 / -1;margin:6px 0 0;font-size:.93rem;line-height:1.65;color:var(--text);}

  /* sections ---------------------------------------------------------- */
  section{margin-top:20px;}
  h2{font-family:var(--mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent-ink);
     margin:0 0 10px;padding-bottom:5px;border-bottom:1px solid var(--line);font-weight:500;}

  .job{margin-bottom:12px;}
  .job:last-child{margin-bottom:0;}
  .job-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:3px;}
  .job-head .co{font-weight:600;color:var(--ink);font-size:.97rem;}
  .job-head .role{color:var(--text);}
  .job-head .role::before{content:"· ";color:var(--soft);}
  .job-head .period{font-family:var(--mono);font-size:.72rem;color:var(--soft);white-space:nowrap;}
  .job ul{margin:0;padding-left:1.1em;}
  .job li{margin:0 0 3px;font-size:.9rem;line-height:1.55;}
  .job li::marker{color:var(--accent);}
  .job.compact li{font-size:.86rem;}

  .two{display:grid;grid-template-columns:1.55fr 1fr;gap:0 36px;}
  .rows{display:grid;gap:6px;}
  .row{display:grid;grid-template-columns:96px 1fr;gap:0 14px;font-size:.86rem;line-height:1.5;}
  .row .k{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);padding-top:3px;}
  .edu{font-size:.86rem;line-height:1.5;margin-bottom:6px;}
  .edu .sc{font-weight:600;color:var(--ink);}
  .edu .dg{color:var(--text);}
  .edu .pd{font-family:var(--mono);font-size:.7rem;color:var(--soft);}

  @media (max-width:640px){
    .sheet{padding:32px 22px 28px;margin-top:8px;}
    header{grid-template-columns:1fr;}
    .contact{text-align:left;white-space:normal;}
    .two{grid-template-columns:1fr;}
    .job-head{flex-wrap:wrap;}
  }

  /* print: A4, one page -------------------------------------------------- */
  @page{size:A4;margin:9mm 12mm 8mm;}
  @media print{
    :root{--paper:#fff;--sheet:#fff;--text:#1f2528;--ink:#000;--soft:#4a5257;--line:#c9ccc7;--accent-tint:#e5e5e5;}
    body{font-size:9pt;line-height:1.38;background:#fff;}
    .topbar,.foot{display:none;}
    .sheet{max-width:none;margin:0;padding:0;box-shadow:none;}
    header{padding-bottom:6pt;gap:2pt 18pt;}
    h1{font-size:18pt;} h1 .alt{margin-top:2pt;}
    .headline{margin-top:5pt;font-size:10.2pt;}
    .summary{margin-top:3pt;font-size:8.6pt;line-height:1.45;}
    .contact{line-height:1.7;font-size:7.4pt;}
    section{margin-top:7.5pt;} h2{margin-bottom:4pt;padding-bottom:2pt;}
    .job{margin-bottom:5pt;break-inside:avoid;} .job-head{margin-bottom:0.5pt;}
    .job li{font-size:8.5pt;line-height:1.38;margin-bottom:1pt;}
    .job.compact li{font-size:8.1pt;}
    .row,.edu{font-size:8.1pt;line-height:1.4;} .rows{gap:2.5pt;} .edu{margin-bottom:2.5pt;}
    a{color:inherit;border:none;}
    /* English runs ~15% longer than Chinese at the same size */
    html[lang=en] body{font-size:8.4pt;line-height:1.32;}
    html[lang=en] .job li{font-size:8pt;line-height:1.3;margin-bottom:0.5pt;}
    html[lang=en] .job.compact li{font-size:7.8pt;}
    html[lang=en] .summary{font-size:8.2pt;line-height:1.38;}
    html[lang=en] .row,html[lang=en] .edu{font-size:7.7pt;line-height:1.32;}
    html[lang=en] .two{grid-template-columns:1.8fr 1fr;gap:0 24pt;}
    html[lang=en] .row{grid-template-columns:78pt 1fr;}
    html[lang=en] section{margin-top:6pt;} html[lang=en] .job{margin-bottom:4pt;} html[lang=en] h2{margin-bottom:3pt;}
    html[lang=en] header{padding-bottom:5pt;} html[lang=en] h1{font-size:17pt;} html[lang=en] .headline{margin-top:3pt;font-size:9.6pt;}
  }
</style>
</head>
<body>
<div class="topbar">
  <button type="button" class="print-btn" onclick="window.print()">{{ labels.print|t }}</button>
  <a href="{{ '/cv' if lang == 'zh' else '/zh/cv' }}">{{ labels.other_lang|t }}</a>
</div>

<main class="sheet">
  <header>
    <div>
      <span class="eyebrow">{{ person.eyebrow|t }}</span>
      <h1>{{ person.name|t }}<span class="alt">{{ person.alt_name|t }}</span></h1>
      <p class="headline">{{ person.headline|t }}</p>
    </div>
    <div class="contact">
      {{ person.location|t }}<br>
      {% if meta.show_phone %}<a href="tel:{{ person.phone|replace('-','') }}">{{ person.phone }}</a><br>{% endif %}
      <a href="mailto:{{ person.email }}">{{ person.email }}</a><br>
      {% for l in person.links %}<a href="{{ l.href }}">{{ l.label|t }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
    <p class="summary">{{ person.summary|t }}</p>
  </header>

  <section>
    <h2>{{ labels.experience|t }}</h2>
    {% for j in experience %}
    <div class="job{% if loop.index > 2 %} compact{% endif %}">
      <div class="job-head">
        <div><span class="co">{{ j.company|t }}</span><span class="role">{{ j.role|t }}</span></div>
        <div class="period">{{ j.period|t }}</div>
      </div>
      <ul>{% for b in j.bullets %}<li>{{ b|t }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </section>

  <div class="two">
    <section>
      <h2>{{ labels.skills|t }}</h2>
      <div class="rows">
        {% for s in skills %}<div class="row"><div class="k">{{ s.k|t }}</div><div class="v">{{ s.v|t }}</div></div>{% endfor %}
      </div>
    </section>
    <section>
      <h2>{{ labels.education|t }}</h2>
      {% for e in education %}
      <div class="edu"><span class="sc">{{ e.school|t }}</span><br><span class="dg">{{ e.degree|t }}</span> <span class="pd">{{ e.period }}</span></div>
      {% endfor %}
    </section>
  </div>
</main>

<div class="foot">{{ labels.updated|t }} {{ meta.updated }} · {{ meta.site }}{{ '/zh/cv' if lang == 'zh' else '/cv' }}</div>

<!-- GoatCounter — privacy-first analytics (no cookies). Skip your own visits: load any page with #toggle-goatcounter once per browser. -->
<script data-goatcounter="https://myps6415.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
